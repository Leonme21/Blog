@page "/home"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Blog Personal - Inicio</PageTitle>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-light text-white">Blog Personal</h1>
        <p class="text-muted-custom lead">Ideas, pensamientos e historias.</p>
    </div>

    @if (articulos == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted-custom">Cargando los últimos artículos...</p>
        </div>
    }
    else if (!articulos.Any())
    {
        <div class="text-center py-5">
            <div class="card shadow-sm border-0 rounded-lg article-card-hover">
                <div class="card-body">
                    <p class="text-muted-custom mb-0">No hay artículos publicados todavía. ¡Vuelve pronto!</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                @foreach (var articulo in articulos)
                {
                    <div class="card shadow-sm border-0 rounded-lg mb-4 article-card-hover article-card-link" @onclick="() => NavigateToArticle(articulo.Id)">
                        <div class="card-body p-4">
                            <h2 class="h3 fw-normal mb-2 text-white">@articulo.Titulo</h2>
                            <div class="d-flex text-muted-custom small">
                                <span class="me-3"><i class="bi bi-calendar3 me-1"></i> @articulo.FechaPublicacion.ToString("MMMM d, yyyy")</span>
                                <span><i class="bi bi-person me-1"></i> por @articulo.NombreAutor</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<ArticuloResponseDto>? articulos;
    private bool isAdmin = false;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        isAdmin = await AuthService.IsAdminAsync(); 
        await LoadArticles();
    }

    private async Task LoadArticles()
    {
        try
        {
            articulos = await Http.GetFromJsonAsync<List<ArticuloResponseDto>>("api/Articulo");
            if (articulos != null)
            {
                articulos = articulos.OrderByDescending(a => a.FechaPublicacion).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching articles: {ex.Message}");
            articulos = new List<ArticuloResponseDto>();
        }
    }

    private void NavigateToArticle(int id) => Navigation.NavigateTo($"/article/{id}");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/admin/edit/{id}");

    private async Task DeleteArticle(int id)
    {
        var result = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("Swal.fire", new
        {
            title = "¿Estás seguro?",
            text = "Esta acción no se puede deshacer",
            icon = "warning",
            showCancelButton = true,
            confirmButtonColor = "#d33",
            cancelButtonColor = "#3085d6",
            confirmButtonText = "Sí, bórralo",
            cancelButtonText = "Cancelar"
        });

        if (result.TryGetProperty("isConfirmed", out var confirmed) && confirmed.GetBoolean())
        {
            try
            {
                var token = await AuthService.GetTokenAsync();
                var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Articulo/{id}");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                
                var response = await Http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                        title = "¡Eliminado!",
                        text = "El artículo ha sido borrado.",
                        icon = "success",
                        toast = true,
                        position = "top-end",
                        showConfirmButton = false,
                        timer = 2000
                    });
                    await LoadArticles();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting: {ex.Message}");
            }
        }
    }
}
