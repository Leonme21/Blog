@page "/admin/new"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using PersonalBlog.Blazor.Services
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Nuevo Artículo</PageTitle>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Nuevo Artículo</h2>
                <button class="btn btn-outline-secondary" @onclick="NavigateBack">Cancelar</button>
            </div>

            @if (!isAuthorized)
            {
                <div class="alert alert-warning">Verificando autorización...</div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">


                        <EditForm Model="@articleModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label for="title" class="form-label fw-bold">Título del Artículo</label>
                                <InputText id="title" class="form-control form-control-lg" @bind-Value="articleModel.Titulo" placeholder="Escribe un título atractivo..." />
                            </div>
                            
                            <div class="mb-4">
                                <label for="publishDate" class="form-label fw-bold">Fecha de Publicación</label>
                                <InputDate id="publishDate" class="form-control" @bind-Value="articleModel.FechaPublicacion" />
                            </div>

                            <div class="mb-4">
                                <label for="content" class="form-label fw-bold">Contenido</label>
                                <InputTextArea id="content" class="form-control" @bind-Value="articleModel.Contenido" rows="12" placeholder="Escribe aquí tu increíble contenido..." />
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button class="btn btn-primary px-5" type="submit" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Publicando...</span>
                                    }
                                    else
                                    {
                                        <span>Publicar Artículo</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CreateArticuloDto articleModel = new CreateArticuloDto { FechaPublicacion = DateTime.Today };
    private string? token;
    private bool isAuthorized = false;
    private bool isSubmitting = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await AuthService.GetTokenAsync();
            bool esAdmin = await AuthService.IsAdminAsync();

            if (!esAdmin)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            
            isAuthorized = true;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Post, "api/Articulo");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(articleModel);
            
            var response = await Http.SendAsync(request);
            
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                    title = "¡Publicado!",
                    text = "El artículo se ha publicado correctamente.",
                    icon = "success",
                    confirmButtonColor = "#198754"
                });
                Navigation.NavigateTo("/admin");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized || response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await ShowError("Sesión expirada o no autorizada. Por favor inicia sesión de nuevo.");
                Navigation.NavigateTo("/login");
            }
            else
            {
                await ShowError("Error al publicar el artículo. Por favor verifica los datos.");
            }
        }
        catch (Exception ex)
        {
            await ShowError("Ocurrió un error en el servidor al intentar publicar.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new {
            title = "Error",
            text = message,
            icon = "error",
            confirmButtonColor = "#212529"
        });
    }

    private void NavigateBack() => Navigation.NavigateTo("/admin");
}
