@page "/admin/edit/{Id:int}"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using PersonalBlog.Blazor.Services
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Editar Artículo - Administrador</PageTitle>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-sm border-0 rounded-lg form-card">
                <div class="card-header bg-transparent border-0 pt-4 pb-0">
                    <h3 class="fw-light my-2 text-white">Actualizar Artículo</h3>
                    <p class="text-muted-custom small">Modifica el contenido de tu publicación</p>
                </div>
                <div class="card-body p-4">
                    @if (!isAuthorized)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-light" role="status"></div>
                            <p class="mt-2 text-muted-custom small">Verificando autorización...</p>
                        </div>
                    }
                    else if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-light" role="status"></div>
                            <p class="mt-2 text-muted-custom small">Cargando artículo...</p>
                        </div>
                    }
                    else if (articleModel == null)
                    {
                        <div class="alert alert-danger">Artículo no encontrado.</div>
                    }
                    else
                    {
                        <EditForm Model="@articleModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="form-floating mb-3">
                                <InputText id="title" class="form-control form-input-custom" @bind-Value="articleModel.Titulo" placeholder="Título" />
                                <label for="title">Título del Artículo</label>
                            </div>
                            
                            <div class="form-floating mb-3">
                                <InputDate id="publishDate" class="form-control form-input-custom" @bind-Value="articleModel.FechaPublicacion" placeholder="Fecha" />
                                <label for="publishDate">Fecha de Publicación</label>
                            </div>

                            <div class="form-floating mb-4">
                                <InputTextArea id="content" class="form-control form-input-custom content-editor" @bind-Value="articleModel.Contenido" placeholder="Contenido" />
                                <label for="content">Contenido del artículo</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-outline-light border px-4" @onclick="NavigateBack">Cancelar</button>
                                <button class="btn btn-light px-5 fw-bold" type="submit" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Actualizando...</span>
                                    }
                                    else
                                    {
                                        <span>Actualizar</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateArticuloDto? articleModel;
    private string? token;
    private bool isAuthorized = false;
    private bool isLoading = true;
    private bool isSubmitting = false;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await AuthService.GetTokenAsync();
            bool esAdmin = await AuthService.IsAdminAsync();

            if (!esAdmin)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            
            isAuthorized = true;
            StateHasChanged();
            await LoadArticle();
        }
    }

    private async Task LoadArticle()
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Articulo/{Id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var original = await response.Content.ReadFromJsonAsync<ArticuloResponseDto>();
                if (original != null)
                {
                    articleModel = new UpdateArticuloDto
                    {
                        Titulo = original.Titulo,
                        Contenido = original.Contenido,
                        FechaPublicacion = original.FechaPublicacion
                    };
                }
            }
            else
            {
                await ShowError("No se pudo cargar el artículo.");
            }
        }
        catch (Exception ex)
        {
            await ShowError("Error al cargar el artículo.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        if (articleModel == null) return;
        
        isSubmitting = true;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/Articulo/{Id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(articleModel);
            
            var response = await Http.SendAsync(request);
            
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                    title = "¡Actualizado!",
                    text = "El artículo se ha modificado correctamente.",
                    icon = "success",
                    confirmButtonColor = "#198754"
                });
                Navigation.NavigateTo("/admin");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized || response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await ShowError("Sesión expirada o no autorizada.");
                Navigation.NavigateTo("/login");
            }
            else
            {
                await ShowError("Error al actualizar el artículo.");
            }
        }
        catch (Exception ex)
        {
            await ShowError("Ocurrió un error en el servidor al intentar actualizar.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new {
            title = "Error",
            text = message,
            icon = "error",
            confirmButtonColor = "#212529"
        });
    }

    private void NavigateBack() => Navigation.NavigateTo("/admin");
}
