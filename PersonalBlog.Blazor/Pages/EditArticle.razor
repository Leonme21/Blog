@page "/admin/edit/{Id:int}"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using PersonalBlog.Blazor.Services
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Edit Article</PageTitle>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Update Article</h2>
                <button class="btn btn-outline-secondary" @onclick="NavigateBack">Cancel</button>
            </div>

            @if (!isAuthorized)
            {
                <div class="alert alert-warning">Checking authorization...</div>
            }
            else if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (articleModel == null)
            {
                <div class="alert alert-danger">Article not found.</div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <EditForm Model="@articleModel" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-4">
                                <label for="title" class="form-label fw-bold">Article Title</label>
                                <InputText id="title" class="form-control form-control-lg" @bind-Value="articleModel.Titulo" />
                            </div>
                            
                            <div class="mb-4">
                                <label for="publishDate" class="form-label fw-bold">Publishing Date</label>
                                <InputDate id="publishDate" class="form-control" @bind-Value="articleModel.FechaPublicacion" />
                            </div>

                            <div class="mb-4">
                                <label for="content" class="form-label fw-bold">Content</label>
                                <InputTextArea id="content" class="form-control" @bind-Value="articleModel.Contenido" rows="12" />
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button class="btn btn-primary px-5" type="submit" disabled="@isSubmitting">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Updating...</span>
                                    }
                                    else
                                    {
                                        <span>Update</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private UpdateArticuloDto? articleModel;
    private string? token;
    private bool isAuthorized = false;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await AuthService.GetTokenAsync();
            bool esAdmin = await AuthService.IsAdminAsync();

            if (!esAdmin)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            
            isAuthorized = true;
            StateHasChanged();
            await LoadArticle();
        }
    }

    private async Task LoadArticle()
    {
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, $"api/Articulo/{Id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                var original = await response.Content.ReadFromJsonAsync<ArticuloResponseDto>();
                if (original != null)
                {
                    articleModel = new UpdateArticuloDto
                    {
                        Titulo = original.Titulo,
                        Contenido = original.Contenido,
                        FechaPublicacion = original.FechaPublicacion
                    };
                }
            }
            else
            {
                errorMessage = "Could not load the article.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading article.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSubmit()
    {
        if (articleModel == null) return;
        
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var request = new HttpRequestMessage(HttpMethod.Put, $"api/Articulo/{Id}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(articleModel);
            
            var response = await Http.SendAsync(request);
            
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/admin");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized || response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Session expired or unauthorized.");
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = "Failed to update article.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A server error occurred while updating.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateBack() => Navigation.NavigateTo("/admin");
}
