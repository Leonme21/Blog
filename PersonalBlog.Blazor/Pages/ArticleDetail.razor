@page "/article/{Id:int}"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>@(articulo?.Titulo ?? "Cargando...") - Blog Personal</PageTitle>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <button class="btn btn-link text-muted-custom mb-4 p-0 text-decoration-none shadow-none" @onclick="NavigateBack">
                <i class="bi bi-arrow-left me-1"></i> Volver al Inicio
            </button>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-light" role="status"></div>
                    <p class="mt-2 text-muted-custom small">Cargando artículo...</p>
                </div>
            }
            else if (articulo == null)
            {
                <div class="card shadow-sm border-0 rounded-lg text-center py-5 article-detail-card">
                    <div class="card-body">
                        <i class="bi bi-exclamation-circle text-danger display-4 mb-3"></i>
                        <h2 class="fw-light text-white">Artículo no encontrado</h2>
                        <p class="text-muted-custom">El artículo que buscas no existe o ha sido eliminado.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 rounded-lg overflow-hidden article-detail-card">
                    <div class="card-body p-4 p-md-5">
                        <header class="article-header">
                            <h1 class="fw-light display-4 mb-3 text-white">@articulo.Titulo</h1>
                            <div class="d-flex align-items-center text-muted-custom">
                                <span class="me-3 small"><i class="bi bi-calendar3 me-1"></i> @articulo.FechaPublicacion.ToString("MMMM d, yyyy")</span>
                                <span class="small"><i class="bi bi-person me-1"></i> por @articulo.NombreAutor</span>
                            </div>
                        </header>
                        
                        <div class="article-body">
                            @((MarkupString)FormatContent(articulo.Contenido))
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ArticuloResponseDto? articulo;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            articulo = await Http.GetFromJsonAsync<ArticuloResponseDto>($"api/Articulo/{Id}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching article {Id}: {ex.Message}");
            articulo = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/login");
    }

    // A simple method to replace newlines with <br /> for basic formatting
    private string FormatContent(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return string.Empty;
        return System.Net.WebUtility.HtmlEncode(content).Replace("\n", "<br />");
    }
}
