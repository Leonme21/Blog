@page "/admin"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using PersonalBlog.Blazor.Services
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Panel de Administración - Blog Personal</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0 rounded-lg admin-card">
                <div class="card-header bg-transparent border-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="fw-light my-2 text-white">Administración</h3>
                        <p class="text-muted-custom small">Gestiona las entradas de tu blog</p>
                    </div>
                    <button class="btn btn-light shadow-sm px-4 fw-bold" @onclick='() => Navigation.NavigateTo("/admin/new")'>
                        <i class="bi bi-plus-lg me-1"></i> Añadir Nuevo
                    </button>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!isAuthorized)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-light" role="status"></div>
                            <p class="mt-2 text-muted-custom small">Verificando autorización...</p>
                        </div>
                    }
                    else if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-light" role="status"></div>
                            <p class="mt-2 text-muted-custom small">Cargando artículos...</p>
                        </div>
                    }
                    else if (articulos == null || !articulos.Any())
                    {
                        <div class="text-center py-5">
                            <h5 class="text-white fw-light">No se encontraron artículos.</h5>
                            <p class="small text-muted-custom">¡Empieza a escribir tu primera entrada!</p>
                            <button class="btn btn-glass mt-2" @onclick="NavigateToNew">Crear Artículo</button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="thead-custom">
                                    <tr>
                                        <th class="fw-normal py-3 px-4"><i class="bi bi-card-text me-2"></i>Título</th>
                                        <th class="fw-normal py-3"><i class="bi bi-calendar-event me-2"></i>Fecha</th>
                                        <th class="fw-normal py-3 px-4 text-end"><i class="bi bi-gear me-2"></i>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var articulo in articulos)
                                    {
                                        <tr class="border-secondary">
                                            <td class="py-3">
                                                <span class="fw-normal text-white">@articulo.Titulo</span>
                                            </td>
                                            <td class="py-3 text-muted-custom small">
                                                @articulo.FechaPublicacion.ToString("d 'de' MMM, yyyy")
                                            </td>
                                            <td class="py-3 text-end">
                                                <button class="btn btn-sm btn-glass me-1" @onclick="() => NavigateToEdit(articulo.Id)">
                                                    <i class="bi bi-pencil"></i> Editar
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteArticle(articulo.Id)">
                                                    <i class="bi bi-trash"></i> Eliminar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ArticuloResponseDto>? articulos;
    private bool isLoading = true;
    private bool isAuthorized = false;
    private string? token;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await AuthService.GetTokenAsync();
            bool esAdmin = await AuthService.IsAdminAsync();

            if (!esAdmin)
            {
                Navigation.NavigateTo("/home");
                return;
            }

            
            isAuthorized = true;
            StateHasChanged();
            await LoadArticles();
        }
    }

    private async Task LoadArticles()
    {
        isLoading = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, "api/Articulo");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                articulos = await response.Content.ReadFromJsonAsync<List<ArticuloResponseDto>>();
                if (articulos != null)
                {
                    articulos = articulos.OrderByDescending(a => a.FechaPublicacion).ToList();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await Logout();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching articles: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteArticle(int id)
    {
        var result = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("Swal.fire", new
        {
            title = "¿Estás seguro?",
            text = "Esta acción no se puede deshacer",
            icon = "warning",
            showCancelButton = true,
            confirmButtonColor = "#d33",
            cancelButtonColor = "#3085d6",
            confirmButtonText = "Sí, bórralo",
            cancelButtonText = "Cancelar"
        });

        if (result.TryGetProperty("isConfirmed", out var confirmed) && confirmed.GetBoolean())
        {
            try
            {
                var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Articulo/{id}");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                
                var response = await Http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                        title = "¡Eliminado!",
                        text = "El artículo ha sido borrado.",
                        icon = "success",
                        toast = true,
                        position = "top-end",
                        showConfirmButton = false,
                        timer = 2000
                    });
                    await LoadArticles();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    await Logout();
                }
                else 
                {
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                        title = "Error",
                        text = "No se pudo eliminar. Verifica que seas Admin.",
                        icon = "error"
                    });
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting article: {ex.Message}");
            }
        }
    }

    private void NavigateToNew() => Navigation.NavigateTo("/admin/new");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/admin/edit/{id}");

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Navigation.NavigateTo("/login");
    }
}
