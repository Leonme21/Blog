@page "/admin"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using PersonalBlog.Blazor.Services
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Panel de Administración</PageTitle>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Blog Personal <span class="text-muted fs-5">| Panel de Administración</span></h2>
        <div>
            <button class="btn btn-primary me-2" @onclick='() => Navigation.NavigateTo("/admin/new")'>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg me-1" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                </svg>
                Añadir Nuevo
            </button>
        </div>
    </div>

    @if (!isAuthorized)
    {
        <div class="alert alert-warning">Verificando autorización...</div>
    }
    else if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (articulos == null || !articulos.Any())
    {
        <div class="card text-center py-5 shadow-sm border-0">
            <div class="card-body">
                <h5 class="text-muted">No se encontraron artículos.</h5>
                <p>¡Empieza a escribir tu primera entrada!</p>
                <button class="btn btn-primary mt-2" @onclick="NavigateToNew">Crear Artículo</button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="list-group list-group-flush">
                @foreach (var articulo in articulos)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h5 class="mb-1">@articulo.Titulo</h5>
                            <small class="text-muted">Publicado: @articulo.FechaPublicacion.ToString("d 'de' MMM, yyyy")</small>
                        </div>
                        <div>
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => NavigateToEdit(articulo.Id)">Editar</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteArticle(articulo.Id)">Eliminar</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<ArticuloResponseDto>? articulos;
    private bool isLoading = true;
    private bool isAuthorized = false;
    private string? token;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            token = await AuthService.GetTokenAsync();
            bool esAdmin = await AuthService.IsAdminAsync();

            if (!esAdmin)
            {
                Navigation.NavigateTo("/home");
                return;
            }

            
            isAuthorized = true;
            StateHasChanged();
            await LoadArticles();
        }
    }

    private async Task LoadArticles()
    {
        isLoading = true;
        try
        {
            var request = new HttpRequestMessage(HttpMethod.Get, "api/Articulo");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            
            var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                articulos = await response.Content.ReadFromJsonAsync<List<ArticuloResponseDto>>();
                if (articulos != null)
                {
                    articulos = articulos.OrderByDescending(a => a.FechaPublicacion).ToList();
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await Logout();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching articles: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task DeleteArticle(int id)
    {
        var result = await JSRuntime.InvokeAsync<System.Text.Json.JsonElement>("Swal.fire", new
        {
            title = "¿Estás seguro?",
            text = "Esta acción no se puede deshacer",
            icon = "warning",
            showCancelButton = true,
            confirmButtonColor = "#d33",
            cancelButtonColor = "#3085d6",
            confirmButtonText = "Sí, bórralo",
            cancelButtonText = "Cancelar"
        });

        if (result.TryGetProperty("isConfirmed", out var confirmed) && confirmed.GetBoolean())
        {
            try
            {
                var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Articulo/{id}");
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
                
                var response = await Http.SendAsync(request);
                if (response.IsSuccessStatusCode)
                {
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                        title = "¡Eliminado!",
                        text = "El artículo ha sido borrado.",
                        icon = "success",
                        toast = true,
                        position = "top-end",
                        showConfirmButton = false,
                        timer = 2000
                    });
                    await LoadArticles();
                }
                else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    await Logout();
                }
                else 
                {
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                        title = "Error",
                        text = "No se pudo eliminar. Verifica que seas Admin.",
                        icon = "error"
                    });
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error deleting article: {ex.Message}");
            }
        }
    }

    private void NavigateToNew() => Navigation.NavigateTo("/admin/new");
    private void NavigateToEdit(int id) => Navigation.NavigateTo($"/admin/edit/{id}");

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Navigation.NavigateTo("/login");
    }
}
