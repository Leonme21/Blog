@page "/"
@page "/login"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Iniciar Sesión - Blog Personal</PageTitle>

<div class="login-page">
    <canvas id="particleCanvas"></canvas>

    <div class="login-container">
        <div class="login-card">
            <div class="card-glow"></div>

            <div class="card-header-custom">
                <div class="icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z" />
                    </svg>
                </div>
                <h2>Bienvenido de nuevo</h2>
                <p class="subtitle">Inicia sesión para gestionar tu blog</p>
            </div>

            <div class="card-body-custom">
                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="input-group-custom">
                        <div class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z" />
                            </svg>
                        </div>
                        <InputText id="username" class="form-input" @bind-Value="loginModel.UserName" placeholder=" " />
                        <label for="username">Nombre de usuario</label>
                    </div>

                    <div class="input-group-custom">
                        <div class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                            </svg>
                        </div>
                        <InputText id="password" type="password" class="form-input" @bind-Value="loginModel.Password" placeholder=" " />
                        <label for="password">Contraseña</label>
                    </div>

                    <button class="btn-login" type="submit" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <div class="btn-loader">
                                <span class="loader-dot"></span>
                                <span class="loader-dot"></span>
                                <span class="loader-dot"></span>
                            </div>
                        }
                        else
                        {
                            <span>Entrar</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                            </svg>
                        }
                    </button>
                </EditForm>
            </div>

            <div class="card-footer-custom">
                <p>¿No tienes cuenta? <a href="/register" class="link-action">¡Regístrate aquí!</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    private AuthRequestDto loginModel = new AuthRequestDto();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/home");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("particles.init");
        }
    }

    private async Task HandleLogin()
    {
        if (isLoading) return;
        isLoading = true;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync("api/User/Login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponseWrapper>();
                if (result?.Token != null && result.Token.Success)
                {
                    await AuthService.LoginAsync(result.Token.Token);

                    await JSRuntime.InvokeVoidAsync("Swal.fire", new
                    {
                        title = "¡Bienvenido!",
                        text = "Inicio de sesión exitoso",
                        icon = "success",
                        confirmButtonColor = "#000",
                        timer = 2000,
                        showConfirmButton = false
                    });

                    await Task.Delay(1000);
                    Navigation.NavigateTo("/home");
                }
                else
                {
                    await ShowError(result?.Token?.Message ?? "Credenciales inválidas.");
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                await ShowError("El servidor no respondió (404). Verifica que la API esté corriendo.");
            }
            else
            {
                await ShowError("Credenciales incorrectas o problema de red.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Login Exception: {ex.Message}");
            await ShowError("No se pudo conectar con el servidor.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new
        {
            title = "Error",
            text = message,
            icon = "error",
            confirmButtonColor = "#000"
        });
    }

    public class AuthResponseWrapper
    {
        public AuthResponseDto Token { get; set; } = new AuthResponseDto();
    }
}