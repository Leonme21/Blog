@page "/"
@page "/login"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Iniciar Sesión - Blog Personal</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 rounded-lg mt-5">
                <div class="card-header text-center bg-transparent border-0 pt-4 pb-0">
                    <h3 class="font-weight-light my-2">Bienvenido de nuevo</h3>
                    <p class="text-muted small">Inicia sesión para gestionar tu blog</p>
                </div>
                <div class="card-body">
                    <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                        <DataAnnotationsValidator />
                        
                        <div class="form-floating mb-3">
                            <InputText id="username" class="form-control" @bind-Value="loginModel.UserName" placeholder="Username" />
                            <label for="username">Nombre de usuario</label>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" placeholder="Password" />
                            <label for="password">Contraseña</label>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                            <button class="btn btn-dark w-100 py-2" type="submit" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <span>Entrar</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
                <div class="card-footer text-center py-3 bg-white border-0">
                    <p class="small mb-0">¿No tienes cuenta? <a href="/register" class="text-primary font-weight-bold">¡Regístrate aquí!</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AuthRequestDto loginModel = new AuthRequestDto();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/home");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/User/Login", loginModel);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponseWrapper>();
                if (result != null && result.Token != null && result.Token.Success)
                {
                    await AuthService.LoginAsync(result.Token.Token);
                    
                    // Alerta de éxito
                    await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                        title = "¡Bienvenido!",
                        text = "Inicio de sesión exitoso",
                        icon = "success",
                        confirmButtonColor = "#212529"
                    });
                    
                    Navigation.NavigateTo("/home");
                }
                else
                {
                    await ShowError(result?.Token?.Message ?? "Invalid login attempt.");
                }
            }
            else
            {
                await ShowError("Credenciales incorrectas.");
            }
        }
        catch (Exception ex)
        {
            await ShowError("Error de servidor.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new {
            title = "Error",
            text = message,
            icon = "error",
            confirmButtonColor = "#212529"
        });
    }

    public class AuthResponseWrapper
    {
        public AuthResponseDto Token { get; set; } = new AuthResponseDto();
    }
}
