@page "/register"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Registro - Blog Personal</PageTitle>

<div class="register-page">
    <canvas id="particleCanvas"></canvas>
    
    <div class="register-container">
        <div class="register-card">
            <div class="card-glow"></div>
            
            <div class="card-header-custom">
                <div class="icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                    </svg>
                </div>
                <h2>Crear Cuenta</h2>
                <p class="subtitle">Únete como nuevo administrador</p>
            </div>
            
            <div class="card-body-custom">
                <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                    <DataAnnotationsValidator />
                    
                    <div class="input-group-custom">
                        <div class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                            </svg>
                        </div>
                        <InputText id="nombre" class="form-input" @bind-Value="registerModel.Nombre" placeholder=" " />
                        <label for="nombre">Nombre completo</label>
                    </div>
                    
                    <div class="input-group-custom">
                        <div class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                            </svg>
                        </div>
                        <InputText id="username" class="form-input" @bind-Value="registerModel.UserName" placeholder=" " />
                        <label for="username">Nombre de usuario</label>
                    </div>

                    <div class="input-group-custom">
                        <div class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/>
                            </svg>
                        </div>
                        <InputText id="email" type="email" class="form-input" @bind-Value="registerModel.Email" placeholder=" " />
                        <label for="email">Correo electrónico</label>
                    </div>
                    
                    <div class="input-group-custom">
                        <div class="input-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                            </svg>
                        </div>
                        <InputText id="password" type="password" class="form-input" @bind-Value="registerModel.Contraseña" placeholder=" " />
                        <label for="password">Contraseña</label>
                    </div>

                    <button class="btn-register" type="submit" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <div class="btn-loader">
                                <span class="loader-dot"></span>
                                <span class="loader-dot"></span>
                                <span class="loader-dot"></span>
                            </div>
                        }
                        else
                        {
                            <span>Registrarse</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                                <path d="M4 1a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 4 1zm8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 12 1zm-4 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 1zm4 8a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2a.5.5 0 0 1 .5-.5zm-8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 4 9zm4 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2a.5.5 0 0 1 .5-.5z"/>
                            </svg>
                        }
                    </button>
                </EditForm>
            </div>
            
            <div class="card-footer-custom">
                <p>¿Ya tienes cuenta? <a href="/login" class="link-action">Inicia sesión aquí</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDto registerModel = new RegisterRequestDto();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/home");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("particles.init");
        }
    }

    private async Task HandleRegister()
    {
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/User/Register", registerModel);
            
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                    title = "¡Éxito!",
                    text = "Cuenta creada correctamente",
                    icon = "success",
                    confirmButtonColor = "#000"
                });
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                await ShowError(string.IsNullOrEmpty(errorText) ? "Error en el registro. Intenta con otro correo o usuario." : errorText);
            }
        }
        catch (Exception ex)
        {
            await ShowError("Error de servidor.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new {
            title = "Error",
            text = message,
            icon = "error",
            confirmButtonColor = "#000"
        });
    }
}
