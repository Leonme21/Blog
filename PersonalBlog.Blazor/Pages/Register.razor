@page "/register"
@using PersonalBlog.Application.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PersonalBlog.Blazor.Services.AuthService AuthService
@inject IJSRuntime JSRuntime

<PageTitle>Registro - Blog Personal</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-lg mt-5">
                <div class="card-header text-center bg-transparent border-0 pt-4 pb-0">
                    <h3 class="font-weight-light my-2">Crear Cuenta</h3>
                    <p class="text-muted small">Únete como nuevo administrador</p>
                </div>
                <div class="card-body">
                    <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="form-floating mb-3">
                            <InputText id="nombre" class="form-control" @bind-Value="registerModel.Nombre" placeholder="Full Name" />
                            <label for="nombre">Nombre Completo</label>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <InputText id="username" class="form-control" @bind-Value="registerModel.UserName" placeholder="Username" />
                            <label for="username">Nombre de usuario</label>
                        </div>

                        <div class="form-floating mb-3">
                            <InputText id="email" type="email" class="form-control" @bind-Value="registerModel.Email" placeholder="name@example.com" />
                            <label for="email">Correo electrónico</label>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <InputText id="password" type="password" class="form-control" @bind-Value="registerModel.Contraseña" placeholder="Password" />
                            <label for="password">Contraseña</label>
                        </div>

                        <div class="mt-4 mb-0">
                            <button class="btn btn-primary w-100 py-2" type="submit" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <span>Registrarse</span>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
                <div class="card-footer text-center py-3 bg-white border-0">
                    <div class="small">¿Ya tienes cuenta? <a href="/login" class="text-primary font-weight-bold">Inicia sesión aquí</a></div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequestDto registerModel = new RegisterRequestDto();
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (await AuthService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/home");
        }
    }

    private async Task HandleRegister()
    {
        isLoading = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/User/Register", registerModel);
            
            if (response.IsSuccessStatusCode)
            {
                await JSRuntime.InvokeVoidAsync("Swal.fire", new {
                    title = "¡Éxito!",
                    text = "Cuenta creada correctamente",
                    icon = "success",
                    confirmButtonColor = "#0d6efd"
                });
                Navigation.NavigateTo("/login");
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                await ShowError(string.IsNullOrEmpty(errorText) ? "Error en el registro. Intenta con otro correo o usuario." : errorText);
            }
        }
        catch (Exception ex)
        {
            await ShowError("Error de servidor.");
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ShowError(string message)
    {
        await JSRuntime.InvokeVoidAsync("Swal.fire", new {
            title = "Error",
            text = message,
            icon = "error",
            confirmButtonColor = "#212529"
        });
    }
}
